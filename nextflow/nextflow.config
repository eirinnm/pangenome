// Nextflow pipeline for generating a graph pangenome and aligning RNA-seq reads to it and a linear reference.
// Note: Using Nextflow strict syntax.

docker.enabled = true
docker.runOptions = "-u \$(id -u):\$(id -g)"

params {
  aws_region  = 'eu-north-1'
  aws_queue   = 'nextflow-queue'
  s3_bucket   = 's3://eirinn-pangenome'
  data_dir    = "${projectDir}/data"
  outdir      = 'results'
  tracedir    = "${params.outdir}/pipeline_info"
  timestamp   = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
  fusion {
    prefetch = 20
  }

  // Reference and alignment parameters (override via a species profile)
  linear_name       = 'linear'
  pangenome_name    = null
  vcf               = null
  vcf_index         = null
  regions           = null
  accession_list    = null
  min_intronlen     = 20
  max_intronlen     = 60000
}

profiles {
  // Local execution profile
  standard {
    params.results_path = "${params.outdir}/${params.timestamp}"
    executor.queueSize = 1
    process {
      cpus = 4
      memory = '3 GB'
    }
  }

  // AWS Batch execution profile
  batch {
    params.results_path = "${params.s3_bucket}/${params.outdir}/${params.timestamp}"
    aws.region = params.aws_region
    aws.profile = 'nextflow'
    fusion.enabled = true
    wave.enabled = true
    includeConfig 'nextflow.secrets.config'
    workDir = "${params.s3_bucket}/work"
    params.data_dir = "${params.s3_bucket}/data"

    executor.queueSize = 50

    process {
      executor = 'awsbatch'
      queue = params.aws_queue
      time = '23h'

      withName: ALIGN_AND_SORT {
        cpus = 8
        memory = '16 GB'
      }
      withName: FEATURECOUNTS {
        cpus = 8
        memory = '2 GB'
      }
      withName: FASTP {
        cpus = 8
        memory = '8 GB'
        time = '1h'
      }
      withName: STRINGTIE {
        cpus = 2      // Reduced from 8
        memory = '2 GB' // Reduced from 16 GB
      }
      withName: DESEQ2 {
        cpus = 4
        memory = '2 GB'
      }
      withName: HISAT2_PANGENOME_INDEX {
        cpus = 8
        memory = '32 GB'
      }
      withName: PREP_HISAT2_PANGENOME {
        cpus = 2
        memory = '32 GB'
      }
      withName: HISAT2_INDEX {
        cpus = 8
        memory = '32 GB'
      }
      withName: BCFTOOLS_VCF_FILTER {
        cpus = 2
        memory = '8 GB'
      }
      withName: TO_CRAM {
        cpus = 4
        memory = '4 GB'
      }
      withName: BAM_TO_BIGWIG {
        cpus = 4
        memory = '8 GB'
      }
    }
  }

  // Arabidopsis thaliana (TAIR10 linear genome + Asia pangenome)
  arabidopsis {
    params.linear_name     = 'TAIR10'
    params.linear_fasta    = "${params.data_dir}/TAIR10/TAIR10_chr_all.fas"
    params.vcf             = "${params.data_dir}/VCF/1001genomes_snp-short-indel_with_tair10_only_ACGTN.vcf.gz"
    params.vcf_index       = "${params.data_dir}/VCF/1001genomes_snp-short-indel_with_tair10_only_ACGTN.vcf.gz.tbi"
    params.regions         = null
    params.accession_list  = "${params.data_dir}/accessions/asia.txt"
    params.gtf             = "${params.data_dir}/TAIR10/Araport11_GTF_genes_transposons.Mar202021.gtf"
    params.min_intronlen   = 20
    params.max_intronlen   = 10000
  }
}

process {

  withName: STRINGTIE {
    publishDir = [
      [
        path: { "${params.results_path}/stringtie" },
        mode: 'copy',
        overwrite: true
      ],
      [
        path: { "${params.data_dir}/results/latest/stringtie" },
        mode: 'copy',
        overwrite: true
      ]
    ]
  }

  withName: DESEQ2 {
    publishDir = [
      [
        path: { "${params.results_path}/deseq2" },
        mode: 'copy',
        overwrite: true
      ],
      [
        path: { "${params.data_dir}/results/latest/deseq2" },
        mode: 'copy',
        overwrite: true
      ]
    ]
  }

  withName: HISAT2_INDEX {
    container = 'quay.io/biocontainers/hisat2:2.2.2--h503566f_0'
  }

  withName: ALIGN_AND_SORT {
    container = 'quay.io/biocontainers/mulled-v2-a97e90b3b802d1da3d6958e0867610c718cb5eb1:2880dd9d8ad0a7b221d4eacda9a818e92983128d-0'
  }

  withName: FEATURECOUNTS {
    container = 'quay.io/biocontainers/subread:2.1.1--h577a1d6_0'
  }

  withName: DESEQ2 {
    container = 'quay.io/biocontainers/bioconductor-deseq2:1.50.2--r45ha27e39d_0'
  }

  withName: FASTP {
    container = 'quay.io/biocontainers/fastp:1.3.3--h43da1c4_0'
  }

  withName: STRINGTIE {
    container = 'quay.io/biocontainers/stringtie:3.0.3--h29c0135_0'
  }

  withName: BCFTOOLS_VCF_FILTER {
    container = 'quay.io/biocontainers/bcftools:1.23.1--hb2cee57_0'
  }

  withName: VCF_CONCAT {
    container = 'quay.io/biocontainers/bcftools:1.23.1--hb2cee57_0'
  }

  withName: TO_CRAM {
    publishDir = [
      [
        path: { "${params.results_path}/cram" },
        mode: 'copy',
        overwrite: true
      ],
      [
        path: { "${params.data_dir}/results/latest/cram" },
        mode: 'copy',
        overwrite: true
      ]
    ]
    container = 'quay.io/biocontainers/samtools:1.21--h50ea8bc_0'
  }

  withName: BAM_TO_BIGWIG {
    publishDir = [
      [
        path: { "${params.results_path}/bigwig" },
        mode: 'copy',
        overwrite: true
      ],
      [
        path: { "${params.data_dir}/results/latest/bigwig" },
        mode: 'copy',
        overwrite: true
      ]
    ]
    container = 'quay.io/biocontainers/deeptools:3.5.5--pyhdfd78af_0'
  }

  withName: HISAT2_PANGENOME_INDEX {
        container = 'quay.io/biocontainers/hisat2:2.2.2--h503566f_0'
  }

  withName: PREP_HISAT2_PANGENOME {
    container = 'quay.io/biocontainers/pandas:2.2.1'
  }
}